# ── 실시간 서버 (광장) ──
# 브라우저가 접속하는 실시간 서버 주소
NEXT_PUBLIC_REALTIME_URL=http://localhost:2567
# 실시간 서버 포트
PORT=2567
# 광장 방(채널)당 정원. 비우면 src/config/game.ts 기본값을 쓴다.
PLAZA_ROOM_CAPACITY=
# 서버를 여러 대로 늘릴 때만 설정한다. 비우면 서버 한 대의 메모리로 동작한다.
REDIS_URL=

# ── 토론 매치: DB와 로그인 (Supabase) ──
# 비워 두면 개발용 PGlite(~/.mbti-town/pglite)와 개발용 로그인을 쓴다. 운영에서는 반드시 채운다.
# Supabase 대시보드 > Connect > Transaction pooler 주소
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 예약 작업 (선택) ──
# /api/cron/debate 를 부를 때 Authorization: Bearer 뒤에 붙이는 비밀값
CRON_SECRET=

# ── 로컬에서 운영 빌드(npm start)를 키 없이 확인할 때만. 실제 운영에서는 쓰지 않는다 ──
# DEBATE_ALLOW_PGLITE=1
# DEBATE_ALLOW_DEV_LOGIN=1
# PGLITE_DIR=
