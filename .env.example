# ── DB와 로그인 (Supabase) ──
# 비워 두면 개발용 PGlite(~/.mbti-town/pglite)와 개발용 로그인을 쓴다. 운영에서는 반드시 채운다.
# Supabase 대시보드 > Connect > Transaction pooler 주소
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase에서 켠 소셜 로그인만 쉼표로 (예: kakao,google). 비우면 이메일 로그인 링크만 보인다.
NEXT_PUBLIC_AUTH_PROVIDERS=

# ── 마을 실시간 서버 ──
# 브라우저가 접속하는 실시간 서버 주소. 비우면 지금 주소의 2567 포트 (로컬 개발)
NEXT_PUBLIC_REALTIME_URL=
# 마을 입장 토큰 서명 비밀값. 웹(Vercel)과 실시간 서버(Render)에 똑같이 넣는다.
# 로컬 개발에서는 비워도 된다 (개발용 값을 쓴다). 운영(NODE_ENV=production)에서 비우면 마을에 들어갈 수 없다.
TOWN_TOKEN_SECRET=
# 실시간 서버 포트 (Render는 자동으로 넣는다)
PORT=2567
# 마을 방(채널)당 정원. 비우면 src/config/game.ts 기본값을 쓴다.
TOWN_ROOM_CAPACITY=
# 실시간 서버를 여러 대로 늘릴 때만. 비우면 서버 한 대의 메모리로 동작한다.
REDIS_URL=

# ── 예약 작업 (선택) ──
# /api/cron/debate 를 부를 때 Authorization: Bearer 뒤에 붙이는 비밀값.
# Vercel Cron은 이 값을 넣어 두면 자동으로 헤더에 붙여 부른다 (vercel.json).
CRON_SECRET=

# ── 로컬에서 운영 빌드(npm start)를 키 없이 확인할 때만. 실제 운영에서는 쓰지 않는다 ──
# DEBATE_ALLOW_PGLITE=1
# DEBATE_ALLOW_DEV_LOGIN=1
# PGLITE_DIR=
