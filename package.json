{
  "name": "mbti-town",
  "private": true,
  "version": "0.1.0",
  "description": "MBTI 16개 유형이 팀이 되어 토론 대항전을 벌이는 웹 가상 공간",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,rt -c blue,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "next dev",
    "dev:server": "tsx watch --tsconfig server/tsconfig.json server/index.ts",
    "build": "npm run assets:check && next build",
    "start": "next start",
    "start:server": "tsx --tsconfig server/tsconfig.json server/index.ts",
    "assets:ph": "tsx scripts/gen-placeholders.ts",
    "assets:check": "tsx scripts/check-assets.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@colyseus/core": "0.18.25",
    "@colyseus/redis-driver": "0.18.7",
    "@colyseus/redis-presence": "0.18.6",
    "@colyseus/schema": "5.0.43",
    "@colyseus/sdk": "0.18.9",
    "@colyseus/ws-transport": "0.18.4",
    "@electric-sql/pglite": "0.5.14",
    "@react-three/fiber": "9.8.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "postgres": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "concurrently": "10.0.6",
    "pretendard": "1.3.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
