{
  "name": "project-scene",
  "private": true,
  "version": "0.1.0",
  "description": "PROJECT SCENE: 나만의 3D 미니룸에 취향·음악·기록을 담는 공간형 소셜 플랫폼",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node -e \"require('fs').rmSync('.next/dev',{recursive:true,force:true})\" && next dev",
    "build": "npm run assets:check && next build",
    "start": "next start",
    "assets:ph": "tsx scripts/gen-placeholders.ts",
    "assets:check": "tsx scripts/check-assets.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "tsx scripts/test-postgres.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@react-three/fiber": "9.8.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "postgres": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "three": "0.187.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "0.2.17",
    "@gltf-transform/core": "4.5.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "pretendard": "1.3.9",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
