{
  "name": "project-scene",
  "private": true,
  "version": "0.1.0",
  "description": "PROJECT SCENE: 걸어 다니는 3D 마을과 그 안의 나만의 방 (공간형 소셜 플랫폼)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n web,rt -c blue,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "node -e \"require('fs').rmSync('.next/dev',{recursive:true,force:true})\" && next dev",
    "dev:server": "tsx watch --tsconfig server/tsconfig.json server/index.ts",
    "build": "npm run assets:check && next build",
    "start": "next start",
    "start:server": "tsx --tsconfig server/tsconfig.json server/index.ts",
    "assets:ph": "tsx scripts/gen-placeholders.ts",
    "assets:check": "tsx scripts/check-assets.ts",
    "assets:kenney": "tsx scripts/import-kenney.ts",
    "assets:music": "tsx scripts/import-music.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "test": "vitest run",
    "test:postgres": "tsx scripts/test-postgres.ts",
    "db:bundle": "tsx scripts/bundle-sql.ts",
    "assets:characters": "tsx scripts/import-characters.ts",
    "assets:pet-thumbs": "tsx scripts/render-pet-thumbs.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.18.25",
    "@colyseus/redis-driver": "0.18.7",
    "@colyseus/redis-presence": "0.18.6",
    "@colyseus/schema": "5.0.43",
    "@colyseus/sdk": "0.18.9",
    "@colyseus/ws-transport": "0.18.4",
    "@electric-sql/pglite": "0.5.14",
    "@react-three/fiber": "9.8.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "postgres": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "three": "0.187.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "0.2.17",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "concurrently": "10.0.6",
    "meshoptimizer": "1.1.1",
    "pretendard": "1.3.9",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
