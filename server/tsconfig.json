{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "es2023"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "./**/*.ts",
    "../src/config/**/*.ts",
    "../src/shared/**/*.ts",
    "../src/design/**/*.ts"
  ],
  "exclude": [
    "../src/**/*.test.ts"
  ]
}
